# App name: same as the repository name (lowercase)
APP_NAME=milanvulin-site
# Image registry and owner
REGISTRY=ghcr.io/vulinm
# Public repository whose build workflow runs the site displays
GITHUB_REPO=vulinm/milanvulin-site
# Local language model for the chat panel (OpenAI-compatible server, e.g. Ollama). Leave empty to switch the chat off.
LLM_URL=
LLM_MODEL=
